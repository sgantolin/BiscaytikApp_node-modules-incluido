$(document).ready(function () {
    $('div#s4-workspace').scroll(function () {

        if ($(this).scrollTop() > 100) {

            $('.scrollup').fadeIn();
        } else {

            $('.scrollup').fadeOut();
        }
    });

    $('.scrollup').click(function () {
        $('#s4-workspace').animate({ scrollTop: 0 }, 500);
        return false;
    });

});
